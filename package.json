{
  "name": "buddywash-server",
  "version": "1.0.0",
  "description": "Buddy Wash Laundry — order system with built-in LAN server",
  "main": "main.js",
  "author": "Buddy Wash",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.buddywash.orders",
    "productName": "Buddy Wash",
    "files": ["main.js", "server.js", "public/**/*", "build/icon.png", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
